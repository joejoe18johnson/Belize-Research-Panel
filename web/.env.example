# Text logo (default on) — faster testing without PNG downloads. Set to false for image logos.
NEXT_PUBLIC_USE_TEXT_LOGO=true

# Canonical site URL for SEO (sitemap, Open Graph, JSON-LD). Example: https://www.belizeresearchpanel.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App URL used for verification/reset links (use localhost in dev — not 0.0.0.0)
NEXT_PUBLIC_APP_URL=http://localhost:3000

AUTH_SESSION_SECRET=replace-with-a-long-random-string

# Enable demo logins and dev tooling on a staging/production Netlify site
ENABLE_DEMO_ACCOUNTS=true
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=true
ENABLE_POINTS_OVERRIDE=true

# Show the public Admin button on the home page (set false when staff use a private link only)
NEXT_PUBLIC_SHOW_ADMIN_ENTRY=true

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
# Plain email only (recommended). The app adds the display name.
# Must be on a Resend-verified domain, e.g. noreply@info.dashboardresearch.com
RESEND_FROM_EMAIL=noreply@info.dashboardresearch.com

# Monitored support inbox for /help contact form (also shown on the help page)
SUPPORT_INBOX_EMAIL=support@belizepanel.test
PRIVACY_CONTACT_EMAIL=privacy@belizepanel.test

# Operator alert when a new panelist creates an account (name + email)
SIGNUP_NOTIFY_EMAIL=johannesjohnsonj@gmail.com

# Optional admin API key for contact-change approval routes
ADMIN_API_KEY=

# Admin console password (legacy super-admin fallback when email is left blank)
ADMIN_PASSWORD=

# Supabase (PostgreSQL) — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set USE_SUPABASE=false to keep reading JSON files even when Supabase env is set
USE_SUPABASE=
